{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/apply/route.ts": { "maxDuration": 30 },
    "src/app/api/ai/**/*.ts": { "maxDuration": 60 }
  },
  "git": { "deploymentEnabled": { "main": true } }
}
