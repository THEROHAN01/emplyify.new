# ---- Public ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://emplyify.com
# Cal.com booking link, e.g. https://cal.com/emplyify/hiring-call
NEXT_PUBLIC_CAL_LINK=
# Optional separate event for the GCC team (falls back to NEXT_PUBLIC_CAL_LINK)
NEXT_PUBLIC_CAL_LINK_GCC=
# WhatsApp Business number in international format without "+", e.g. 919800000000
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Privacy-friendly analytics (loaded only after cookie consent)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Content ---------------------------------------------------------------
# "true" shows draft content (sample jobs) — use on preview deployments only.
CONTENT_PREVIEW=

# ---- Server-only -------------------------------------------------------------
TURNSTILE_SECRET_KEY=
HUBSPOT_PORTAL_ID=
HUBSPOT_BRIEF_FORM_ID=
HUBSPOT_CONTACT_FORM_ID=
HUBSPOT_REPORT_FORM_ID=
RESEND_API_KEY=
EMAIL_FROM=Emplyify <hello@emplyify.com>
INTERNAL_ALERT_EMAIL=
SLACK_LEADS_WEBHOOK_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CV_BUCKET=cvs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Random string; used to hash IPs in consent and audit records
IP_HASH_SALT=
